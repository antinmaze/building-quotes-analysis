# Shell environment only: this application does NOT automatically read .env.
# Copy this file to .env, fill endpoints/deployment, then in a POSIX shell:
# set -a; . ./.env; set +a
# Authentication defaults to your existing `az login` session, optionally scoped
# by AZURE_TENANT_ID. No resource provisioning or automatic login is performed.
AZURE_TENANT_ID=
AZURE_SUBSCRIPTION_ID=
AZURE_RESOURCE_GROUP=rg-devis-mngt
AZURE_LOCATION=francecentral
# Subscription/resource group/location are operator context only. Data-plane SDKs
# address the supplied existing endpoints; these variables do not select resources.
AZURE_DOCUMENT_INTELLIGENCE_ENDPOINT=
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_DEPLOYMENT=
AZURE_OPENAI_API_VERSION=2024-10-21
# Bump this after changing the deployed model/version under the same name.
AZURE_OPENAI_MODEL_REVISION=gpt-5-mini-2025-08-07
# Optional key authentication instead of Azure CLI (do not commit real values):
AZURE_DOCUMENT_INTELLIGENCE_KEY=
AZURE_OPENAI_API_KEY=
# Optional local probe server only: devis-mngt serve
PORT=8000
# Local caches contain sensitive document text. Restrict access and exclude
# .devis-cache/, outputs/, .env and *.egg-info/ from source control yourself.
# Existing .gitignore is intentionally not changed by this scaffold.
